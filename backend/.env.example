# ============================================================
# AI 论文写作系统 - 环境变量模板
# 使用方法：复制本文件为 .env 并填写真实值
#   cp .env.example .env
# 注意：.env 已被 .gitignore 排除，切勿提交到 GitHub
# ============================================================

# ---- 数据库（默认 SQLite，文件生成于 data/ 目录）----
DATABASE_URL=sqlite:///./paper_writer.db

# ---- LLM 大脑（DeepSeek，OpenAI 兼容接口）----
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ---- Embedding 向量化（阿里云百炼 text-embedding-v3）----
EMBEDDING_PROVIDER=dashscope
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=text-embedding-v3

# ---- 向量库（Chroma 持久化路径）----
VECTOR_DB_PATH=./data/chroma

# ---- JWT 认证（生产环境务必更换 SECRET_KEY）----
SECRET_KEY=change-me-to-a-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---- 演示模式（公网 Demo 用，本地保持 false）----
# true：模型与向量化都在本地确定性完成，不发起任何外部请求，可无 Key 跑通全流程。
# false：正常调用 DeepSeek + 百炼（需要上面的 Key）。
DEMO_MODE=false
# 启动时自动准备演示数据（42 篇语料 + 演示账号 + 一篇成稿），幂等。
DEMO_SEED_ON_START=true
